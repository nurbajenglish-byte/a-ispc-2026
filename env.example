# ─────────────────────────────────────────────
#  A-ISPC 2026 — Environment Variables Template
#  Copy this file to .env and fill in your keys.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────

# Stripe API Keys (use test keys during development)
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Stripe Price ID (created manually in your Stripe Dashboard)
STRIPE_PRICE_ID=price_REPLACE_ME

# Stripe Webhook Secret (generated when you create a webhook endpoint
# in the Stripe Dashboard → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Server Configuration
PORT=3000

# The public base URL of this server (used to build success/cancel redirect URLs)
# In development: http://localhost:3000
# In production:  https://yourdomain.com
BASE_URL=http://localhost:3000
